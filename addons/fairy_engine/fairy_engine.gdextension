[configuration]
entry_symbol = "fairy_engine_library_init"
compatibility_minimum = "4.5"

[libraries]
windows.debug.x86_64 = "res://addons/fairy_engine/bin/libfairy_engine.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/fairy_engine/bin/libfairy_engine.windows.template_release.x86_64.dll"

linux.debug.x86_64 = "res://addons/fairy_engine/bin/libfairy_engine.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/fairy_engine/bin/libfairy_engine.linux.template_release.x86_64.so"

macos.debug = "res://addons/fairy_engine/bin/libfairy_engine.macos.template_debug.framework"
macos.release = "res://addons/fairy_engine/bin/libfairy_engine.macos.template_release.framework"

android.debug.arm64 = "res://addons/fairy_engine/bin/libfairy_engine.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/fairy_engine/bin/libfairy_engine.android.template_release.arm64.so"

ios.debug.arm64 = "res://addons/fairy_engine/bin/libfairy_engine.ios.template_debug.a"
ios.release.arm64 = "res://addons/fairy_engine/bin/libfairy_engine.ios.template_release.a"
